<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>package-cleaner</AssemblyName>
    <RootNamespace>PackageCleaner</RootNamespace>
    <PackageId>PackageCleaner</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>package-cleaner</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Configuration" Version="7.*" />
    <PackageReference Include="NuGet.Versioning" Version="7.*" />
    <PackageReference Include="System.CommandLine" Version="2.*" />
  </ItemGroup>

</Project>
